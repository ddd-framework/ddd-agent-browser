{
    "name": "mgamadeus/ddd-browser",
    "description": "Browser sessions and website analysis for mgamadeus/ddd: agent-controllable browsing, screenshots, rendered page to markdown, design extraction, on-site SEO, performance and tech audits",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-browser",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-browser/issues",
        "source": "https://github.com/ddd-framework/ddd-browser"
    },
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "keywords": ["ddd", "browser", "headless", "screenshot", "seo", "audit", "ai-agents", "mcp"],
    "require": {
        "php": ">=8.3",
        "mgamadeus/ddd": "^3.40.0",
        "mgamadeus/ddd-argus": "^1.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "suggest": {
        "mgamadeus/ddd-agents": "Adds the browser and page audit tools and skills for agents",
        "mgamadeus/ddd-site-insights": "Shows the on-site findings of a page next to its Search Console data"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DDD\\Tests\\Browser\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
