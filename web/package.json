{
  "name": "@mgamadeus/ddd-agent-browser",
  "version": "0.5.1",
  "description": "React frontend of the agent browser for backends built with mgamadeus/ddd (Composer package mgamadeus/ddd-agent-browser): the RTK Query client of the browser admin routes and the admin screens on the blocks of @mgamadeus/ddd-admin-ui (browser sessions, session log, closing a session, renderer health).",
  "keywords": [
    "ddd",
    "mgamadeus",
    "browser",
    "admin",
    "react",
    "rtk-query"
  ],
  "homepage": "https://github.com/ddd-framework/ddd-agent-browser/tree/main/web#readme",
  "bugs": {
    "url": "https://github.com/ddd-framework/ddd-agent-browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddd-framework/ddd-agent-browser.git",
    "directory": "web"
  },
  "license": "MIT",
  "author": "Marius-Eugen Gerdan <marius@gerdan.net>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./screen": {
      "types": "./dist/screen/index.d.ts",
      "import": "./dist/screen/index.js"
    },
    "./i18n-keys.json": "./dist/i18n-keys.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/copy-i18n-manifest.mjs && node scripts/check-package.mjs .",
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "prepack": "pnpm build",
    "i18n:manifest": "node scripts/build-i18n-manifest.mjs",
    "i18n:check": "node scripts/build-i18n-manifest.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mgamadeus/ddd-admin-ui": ">=0.7.0 <1",
    "@mgamadeus/ddd-web": ">=0.13.0 <1",
    "lucide-react": ">=0.550.0 <2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mgamadeus/ddd-admin-ui": "^0.7.1",
    "@mgamadeus/ddd-web": "^0.17.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.66.0",
    "react-redux": "^9.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
